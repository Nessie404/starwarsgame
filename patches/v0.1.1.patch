+/* ------------------------------------------------------------------ */
+/* Audio: a tiny procedural synth over ASND (no sound assets)          */
+/* ------------------------------------------------------------------ */
+
+#define VOICE_ENGINE  0
+#define VOICE_BEEP    1
+#define ENGINE_CYCLE  256      /* samples in one engine cycle          */
+#define BEEP_RATE     48000
+#define BEEP_LEN      12288    /* max beep length: 256 ms at 48 kHz    */
+
+static s16 *engine_buf = NULL;
+static s16 *beep_buf = NULL;
+static int audio_ok = 0;
+static int beep_countdown_n = -1;   /* last countdown digit we beeped  */
+
+static void audio_init(void)
+{
+    int i;
+
+    ASND_Init();
+    ASND_Pause(0);
+
+    engine_buf = (s16 *)memalign(32, ENGINE_CYCLE * sizeof(s16));
+    beep_buf   = (s16 *)memalign(32, BEEP_LEN * sizeof(s16));
+    if (!engine_buf || !beep_buf)
+        return;     /* no audio, but the game still runs */
+
+    /* One cycle of a buzzy kart engine: square wave plus two harmonics.
+     * Played as an infinite voice whose sample rate we retune every
+     * frame, so the note follows the revs. */
+    for (i = 0; i < ENGINE_CYCLE; i++) {
+        float ph = (float)i / (float)ENGINE_CYCLE;
+        float v = (ph < 0.5f ? 1.0f : -1.0f) * 0.55f +
+                  sinf(ph * 2.0f * (float)M_PI) * 0.30f +
+                  sinf(ph * 4.0f * (float)M_PI) * 0.15f;
+        engine_buf[i] = (s16)(v * 9000.0f);
+    }
+    DCFlushRange(engine_buf, ENGINE_CYCLE * sizeof(s16));
+
+    ASND_SetInfiniteVoice(VOICE_ENGINE, VOICE_MONO_16BIT,
+                          ENGINE_CYCLE * 32, 0,
+                          engine_buf, ENGINE_CYCLE * (s32)sizeof(s16), 0, 0);
+    audio_ok = 1;
+}
+
+/* Fire a short decaying sine on the effects voice. Beeps are brief and
+ * one at a time (a new one simply replaces whatever was playing). */
+static void audio_beep(float freq, int ms, int vol)
+{
+    int n = (BEEP_RATE / 1000) * ms;
+    int i;
+
+    if (!audio_ok)
+        return;
+    if (n > BEEP_LEN) n = BEEP_LEN;
+    for (i = 0; i < n; i++) {
+        float env = 1.0f - (float)i / (float)n;
+        beep_buf[i] = (s16)(sinf(2.0f * (float)M_PI * freq *
+                                 (float)i / (float)BEEP_RATE) *
+                            10000.0f * env);
+    }
+    DCFlushRange(beep_buf, (u32)n * sizeof(s16));
+    ASND_SetVoice(VOICE_BEEP, VOICE_MONO_16BIT, BEEP_RATE, 0, beep_buf,
+                  n * (s32)sizeof(s16), vol, vol, NULL);
+}
+
+/* Engine note follows the player kart: pitch and volume rise with
+ * speed, and a boost adds a little extra howl. */
+static void audio_update(void)
+{
+    const Kart *k = &game.karts[0];
+    float v;
+    int pitch, vol;
+
+    if (!audio_ok)
+        return;
+
+    v = fabsf(k->speed);
+    pitch = (int)((float)ENGINE_CYCLE * (32.0f + v * 3.6f));
+    if (k->boost_t > 0.0f)
+        pitch = (int)((float)pitch * 1.15f);
+    if (pitch > 140000) pitch = 140000;
+
+    vol = 70 + (int)(v * 2.6f);
+    if (vol > 170) vol = 170;
+
+    ASND_ChangePitchVoice(VOICE_ENGINE, pitch);
+    ASND_ChangeVolumeVoice(VOICE_ENGINE, vol, vol);
+}
+
+/* Countdown beeps (3, 2, 1) and the higher, longer GO chime. */
+static void audio_race_cues(void)
+{
+    if (game.state == STATE_COUNTDOWN) {
+        int n = (int)ceilf(game.countdown - 0.2f);
+        if (n > 3) n = 3;
+        if (n >= 1 && n != beep_countdown_n)
+            audio_beep(440.0f, 120, 170);
+        beep_countdown_n = n;
+    } else if (beep_countdown_n != -1) {
+        audio_beep(880.0f, 250, 190);
+        beep_countdown_n = -1;
+    }
+
+    /* boost pads and drift mini-turbos both raise just_boosted */
+    if (game.karts[0].just_boosted)
+        audio_beep(220.0f, 200, 170);
+}
+
+/* ------------------------------------------------------------------ */
+/* USB keyboard (WASD; A = left, D = right)                            */
+/* ------------------------------------------------------------------ */
+
+static int keyboard_ok = 0;
+static u8 key_left, key_right, key_accel, key_brake, key_drift;
+static u8 key_restart_edge, key_quit_edge;
+
+static void poll_keyboard(void)
+{
+    keyboard_event ev;
+
+    if (!keyboard_ok)
+        return;
+
+    while (KEYBOARD_GetEvent(&ev)) {
+        int down;
+
+        if (ev.type == KEYBOARD_DISCONNECTED) {
+            key_left = key_right = key_accel = key_brake = key_drift = 0;
+            continue;
+        }
+        if (ev.type != KEYBOARD_PRESSED && ev.type != KEYBOARD_RELEASED)
+            continue;
+
+        down = (ev.type == KEYBOARD_PRESSED);
+        switch (ev.symbol) {
+        case KS_a: case KS_A: case KS_Left:
+            key_left = (u8)down;
+            break;
+        case KS_d: case KS_D: case KS_Right:
+            key_right = (u8)down;
+            break;
+        case KS_w: case KS_W: case KS_Up:
+            key_accel = (u8)down;
+            break;
+        case KS_s: case KS_S: case KS_Down:
+            key_brake = (u8)down;
+            break;
+        case KS_space: case KS_Shift_L: case KS_Shift_R:
+            key_drift = (u8)down;
+            break;
+        case KS_r: case KS_R:
+            if (down) key_restart_edge = 1;
+            break;
+        case KS_Escape:
+            if (down) key_quit_edge = 1;
+            break;
+        default:
+            break;
+        }
+    }
+}
