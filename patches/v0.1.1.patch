+/* ------------------------------------------------------------------ */
+/* Steering polarity, checked the way a player experiences it           */
+/* ------------------------------------------------------------------ */
+
+/* The chase camera in main.c is guLookAt(eye behind the kart, up = +Y,
+ * looking along the heading), so the direction that appears to the RIGHT
+ * on screen is cross(forward, up) = (-sin h, 0, cos h). That is exactly
+ * the lateral basis (-dz, dx) that track_locate uses, which is why
+ * increasing `heading` swings the kart toward screen right, and why
+ * positive Input.steer (`heading += steer * ...` in game.c) must be a
+ * RIGHT turn. */
+static void screen_right_axis(float heading, float *rx, float *rz)
+{
+    *rx = -sinf(heading);
+    *rz =  cosf(heading);
+}
+
+/* Drive the player kart with one steering input for 0.75 s and report
+ * how far it ended up to the camera's right of where it began. Negative
+ * means it went left on screen, positive means right. */
+static float steer_screen_drift(float steer_input)
+{
+    const float dt = 1.0f / 60.0f;
+    Game g;
+    Input in;
+    float x0, z0, h0, rx, rz;
+    int f;
+
+    game_init(&g);
+    memset(&in, 0, sizeof(in));
+    in.accel = 1;
+
+    /* countdown, then a few seconds of straight-line running */
+    for (f = 0; f < 60 * 5; f++)
+        game_update(&g, &in, dt);
+
+    x0 = g.karts[0].x;
+    z0 = g.karts[0].z;
+    h0 = g.karts[0].heading;
+    screen_right_axis(h0, &rx, &rz);
+
+    in.steer = steer_input;
+    for (f = 0; f < 45; f++)
+        game_update(&g, &in, dt);
+
+    return (g.karts[0].x - x0) * rx + (g.karts[0].z - z0) * rz;
+}
+
+static void test_steer_sign(void)
+{
+    float left  = steer_screen_drift(-1.0f);   /* the A key  */
+    float right = steer_screen_drift(+1.0f);   /* the D key  */
+
+    printf("steering: steer -1 drifts %+.2f units across the screen, "
+           "steer +1 %+.2f\n", left, right);
+
+    CHECK(left < -0.5f,
+          "negative steer (A / D-pad left / left tilt) moved the kart "
+          "%+.2f on screen; it should go LEFT, i.e. negative", left);
+    CHECK(right > 0.5f,
+          "positive steer (D / D-pad right / right tilt) moved the kart "
+          "%+.2f on screen; it should go RIGHT, i.e. positive", right);
+    /* Near mirror images: the small residual is track curvature and the
+     * kart's grid offset, so allow 10% of the average excursion. */
+    CHECK(fabsf(left + right) < 0.10f * 0.5f * (fabsf(left) + fabsf(right)),
+          "left and right are not mirror images (%+.2f vs %+.2f)",
+          left, right);
+
+    /* The same relationship has to hold for the lateral bookkeeping the
+     * AI lines and the walls rely on: positive lat is the camera's
+     * right, so a kart pushed to +lat is on the right of the screen. */
+    {
+        Track t;
+        int seg = 10;
+        float rx, rz, lx, lz, proj, frac, lat;
+        int out_seg;
+
+        track_init(&t);
+        screen_right_axis(atan2f(t.dz[seg], t.dx[seg]), &rx, &rz);
+        lx = -t.dz[seg];
+        lz =  t.dx[seg];
+        track_locate(&t, t.px[seg] + lx * 3.0f, t.pz[seg] + lz * 3.0f, -1,
+                     &out_seg, &frac, &lat);
+        proj = (lx * 3.0f) * rx + (lz * 3.0f) * rz;
+        CHECK(lat > 2.0f, "offset along +lateral gave lat %.2f", lat);
+        CHECK(proj > 2.0f,
+              "positive lat is not the camera's right (projection %.2f)",
+              proj);
+    }
+
+    /* And the heading itself: positive steer must raise it (that is the
+     * rotation the camera turns into a right-hand turn). */
+    {
+        const float dt = 1.0f / 60.0f;
+        Game g;
+        Input in;
+        float h0, dh;
+        int f;
+
+        game_init(&g);
+        memset(&in, 0, sizeof(in));
+        in.accel = 1;
+        for (f = 0; f < 60 * 5; f++)
+            game_update(&g, &in, dt);
+        h0 = g.karts[0].heading;
+        in.steer = 1.0f;
+        for (f = 0; f < 45; f++)
+            game_update(&g, &in, dt);
+        dh = game_angle_wrap(g.karts[0].heading - h0);
+        CHECK(dh > 0.05f, "steer +1 changed heading by %+.3f rad "
+              "(must increase)", dh);
+    }
+}
