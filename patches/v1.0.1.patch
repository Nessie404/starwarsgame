+/*
+ * STEERING SIGN CONVENTION — read before touching any input code.
+ *
+ * The chase camera is built with guLookAt(eye, up=+Y, look) pointing
+ * along the car's heading, so its right-hand axis is
+ *
+ *     right = cross(forward, up) = (-sin h, 0, cos h)
+ *
+ * which is exactly the lateral basis this simulation uses everywhere
+ * (lx = -dz, lz = dx). So increasing `heading` turns the car toward the
+ * RIGHT of the screen, and the physics does `heading += f(steer)`:
+ *
+ *     steer > 0 steers RIGHT,  steer < 0 steers LEFT
+ *
+ * and positive `lat` is to the RIGHT of the direction of travel. Both
+ * are the opposite of what this file used to claim, which is why the
+ * controls shipped mirrored. Input code must map a "left" control to
+ * STEER_LEFT and a "right" control to STEER_RIGHT rather than writing
+ * signs by hand; test_steer_sign() re-derives the camera axis and checks
+ * the car really moves that way.
+ */
+#define STEER_LEFT  (-1.0f)
+#define STEER_RIGHT (+1.0f)
+
 typedef struct {
-    float steer;   /* -1..1, positive = turn left                       */
+    float steer;   /* -1..1; negative = left, positive = right          */
     int   accel;
     int   brake;
     int   hop;     /* handbrake / drift                                 */
@@ -144,7 +168,7 @@ typedef struct {
     float prog_raw;
     float total_progress;
     int   lap;
-    float lat;
+    float lat;            /* signed offset, + = right of travel        */
 
     /* driving state */
     int   spec;           /* index into kart_specs                      */
